[flake8]
# W503 "line break before binary operator" is directly in opposition to how black breaks lines!
# B904 is ignored in .ruff.toml as well, "raise ... from" is not wanted for these examples.
extend-ignore = B904, C901, E201, E202, E203, E211, E221, E251, E266, E501, W503
max-line-length = 120
max-complexity = 18
# T4 (flake8-mypy) is not selected because flake8-mypy is unmaintained, mypy runs as its own step.
select = B,C,E,F,W,B9
